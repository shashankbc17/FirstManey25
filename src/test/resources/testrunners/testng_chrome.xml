<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Opencart App Test Regression Suite" verbose="4"
	thread-count="2" parallel="tests">
	
	<listeners>
		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<listener
			class-name="com.qa.ecommerce.listeners.TestAllureListener" />
			
<!--		 <listener class-name="com.qa.ecommerce.listeners.AnnotationTransformer"/> -->

	</listeners>

	<test name="Login Page Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="126.0" />
		<parameter name="testname" value="Login Page tests" />
		<classes>
			<class name="com.qa.ecommerce.tests.LoginPageTest" />
		</classes>
	</test>
	

	<test name="Accounts Page Test_chrome">
		<parameter name="browser" value="firefox" />
		<parameter name="browserversion" value="124.0" />
		<parameter name="testname" value="Accounts Page tests" />

		<classes>
			<class name="com.qa.ecommerce.tests.AccountsPageTest" />
		</classes>
	</test>
	

	<test name="Search Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="126.0" />
		<parameter name="testname" value="Search Page tests" />

		<classes>
			<class name="com.qa.ecommerce.tests.SearchTest" />
		</classes>
	</test>
	

	




</suite>	
